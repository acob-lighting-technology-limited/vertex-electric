# Sanity — create the Vertex project at sanity.io/manage, then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Public site URL (metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vertexelectricsolutions.com

# Contact channels (a channel left empty is hidden on the site)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Lead delivery via Resend. Until all three are set, forms say enquiries aren't live.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
